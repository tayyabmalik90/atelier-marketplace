# Required in production
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=https://your-domain.com
# Database: leave empty to use embedded Postgres (PGlite, local dev). Set to a Supabase/Postgres URL for production.
DATABASE_URL=
# Payments: leave empty for built-in test-mode checkout. Set for live Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Email (optional): Resend API key. Without it emails are stored in the outbox table and logged.
RESEND_API_KEY=
EMAIL_FROM=Atelier <hello@your-domain.com>
# Seeded admin
ADMIN_EMAIL=admin@atelier.test
ADMIN_PASSWORD=admin12345
